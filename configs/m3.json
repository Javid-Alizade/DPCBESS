{
  "horizon_steps": 24,
  "policy": {"hidden": 128},
  "battery": {
    "p_max_mw": 0.5,
    "q_max_mvar": 0.5,
    "s_max_mva": 0.5,
    "energy_mwh": 1.0,
    "eta_ch": 0.95,
    "eta_dis": 0.95,
    "soc_min": 0.1,
